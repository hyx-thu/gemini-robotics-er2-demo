# =====================================================================
# Gemini Robotics-ER Demo — local environment configuration
#
#   cp agent/.env.example agent/.env   # then fill in the values
#
# agent/.env is gitignored. NEVER put a real key in this example file.
# Cloud Run does NOT use this file — it receives GEMINI_API_KEY from
# Secret Manager via deploy.sh.
# =====================================================================

# --- Required ---------------------------------------------------------
# Gemini API key (Google AI Studio). Used for the Live API session.
GEMINI_API_KEY=your-gemini-api-key-here

# --- Optional ---------------------------------------------------------
# Separate key for TTS; defaults to GEMINI_API_KEY when unset.
# TTS_API_KEY=

# TTS provider / model / voice
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Robot backend. Local mock simulator listens on 8888
# (start it with: python agent/mock_robot_backend.py)
ROBOT_URL=http://127.0.0.1:8888
SPOT_SIMULATED=1

# Which embodiment the UI opens by default: human | spot | tinybot
DEFAULT_AGENT=spot

# Port for the FastAPI server
PORT=8080
